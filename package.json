{
  "name": "compositor-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @compositor/editor",
    "build": "npm run build --workspace @compositor/editor",
    "preview": "npm run preview --workspace @compositor/editor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
